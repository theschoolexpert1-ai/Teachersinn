# Active runtime. Keep sqlite until the Supabase replacement is fully verified.
DATA_BACKEND=sqlite

# Authentication remains legacy until the Supabase Auth bridge and identity
# mappings are deliberately enabled. Never use a shared or guessable secret.
AUTH_BACKEND=legacy
AUTH_COOKIE_SECRET=replace_with_at_least_32_random_characters

# Supabase project API configuration.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Server only. Never expose this value in public/app.js or browser-delivered files.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional: migration/administration tooling only. Prefer a direct connection for
# migrations and a pooler connection for long-lived application traffic.
SUPABASE_DB_URL=postgresql://postgres.project-ref:replace_me@host:5432/postgres
# Stage 3 repository pool. These are read only when a PostgreSQL repository is
# deliberately constructed; normal SQLite startup does not open this pool.
POSTGRES_POOL_MAX=5
POSTGRES_CONNECT_TIMEOUT_MS=10000
POSTGRES_IDLE_TIMEOUT_MS=30000
POSTGRES_STATEMENT_TIMEOUT_MS=15000
POSTGRES_LOCK_TIMEOUT_MS=5000
# Download the project CA certificate from Supabase Database Settings and keep
# the file outside source control. Remote direct connections fail closed without it.
SUPABASE_DB_CA_CERT_PATH=/secure/path/to/prod-supabase.cer

# Cloud Stage A.1 validation only. Use a disposable development project.
# SUPABASE_ACCESS_TOKEN is used by the CLI and must be supplied in the shell,
# not stored in this file. The test suite verifies the URL/ref match.
SUPABASE_PROJECT_REF=replace_with_20_character_project_ref
RUN_SUPABASE_INTEGRATION=0
SUPABASE_TEST_ALLOW_REMOTE=0
SUPABASE_TEST_ENVIRONMENT=development
SUPABASE_TEST_PROJECT_REF=replace_with_20_character_project_ref
SUPABASE_TEST_URL=https://your-project-ref.supabase.co
SUPABASE_TEST_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_TEST_SECRET_KEY=sb_secret_replace_me
# Email-sending tests are separately gated to avoid consuming Auth mail quota.
RUN_SUPABASE_EMAIL_INTEGRATION=0
SUPABASE_TEST_EMAIL=dedicated-disposable-inbox@example.com

# Existing application settings retained during the staged migration.
PORT=3000
HOST=0.0.0.0
APP_ORIGIN=http://localhost:3000
PUBLIC_APP_ORIGIN=https://teachersinn.schoolexpert.in
COOKIE_SECURE=0
TRUST_PROXY=0
TEACHERSINN_DATA_DIR=./data
